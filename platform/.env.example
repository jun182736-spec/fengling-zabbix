# deploy.sh 首次执行会自动生成 .env，本文件仅供查看参数与临时改密。
# 注意：当前版本按需求使用固定密码 zabbix123，仅适合临时/内网环境，
#       正式环境请修改 .env 中的两个密码并妥善保管（重复部署会沿用它）。
COMPOSE_PROJECT_NAME=zabbix-platform
MYSQL_CONTAINER_NAME=zabbix-mysql
SERVER_CONTAINER_NAME=zabbix-server
WEB_CONTAINER_NAME=zabbix-web-custom
MYSQL_VOLUME_NAME=zabbix-platform_mysql-data
WEB_PORT=8080
SERVER_PORT=10051
# 新数据库使用下面的固定密码；已有数据库自动沿用原容器环境中的密码。
MYSQL_PASSWORD='zabbix123'
MYSQL_ROOT_PASSWORD='zabbix123'
